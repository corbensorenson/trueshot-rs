def setCaptureTargetOnCamera(camera, target="Memory card"):
    try:
        # Get the main configuration
        config = camera.get_config()

        # Find the Capture Target property
        property = config.get_child_by_label("Capture Target")

        #for choice in property.get_choices():
        #    print(choice)

        # Set the Capture Target value
        property.set_value(target)

        # Save the configuration
        camera.set_config(config)
        return camera, config
    except gp.GPhoto2Error as e:
        print(f"Error setting Capture Target: {e}")


