def display_live_view(camera, duration=10, interval=1):
    """
    Display live view from the camera for a specified duration.
    
    :param camera: The camera object.
    :param duration: The total duration to display the live view (in seconds).
    :param interval: The interval between each frame capture (in seconds).
    """
    end_time = time.time() + duration
    cv2.namedWindow("Live View", cv2.WINDOW_NORMAL)
    
    while time.time() < end_time:
        # Capture a preview image
        camera_file = camera.capture_preview()
        
        # Read the image data
        file_data = gp.check_result(gp.gp_file_get_data_and_size(camera_file))
        
        # Convert the image data to a PIL Image
        image = Image.open(io.BytesIO(file_data))
        
        # Convert the PIL Image to a format suitable for OpenCV
        open_cv_image = cv2.cvtColor(np.array(image), cv2.COLOR_RGB2BGR)
        
        # Display the image in the OpenCV window
        cv2.imshow("Live View", open_cv_image)
        
        # Wait for the specified interval before capturing the next frame
        if cv2.waitKey(int(interval * 1000)) & 0xFF == ord('q'):
            break
    
    cv2.destroyAllWindows()

def convert_shutter_speed_to_float(shutter_speed):
    if shutter_speed in ["Bulb", "Time"]:
        return float('inf')
    return float(shutter_speed.replace('s', ''))

def find_closest_shutter_speed(shutter_speeds, target_speed):
    target_speed_float = target_speed
    if type(target_speed) != float:
        target_speed_float = convert_shutter_speed_to_float(target_speed)
    shutter_speeds_float = [convert_shutter_speed_to_float(speed) for speed in shutter_speeds]
    closest_speed = min(shutter_speeds_float, key=lambda x: abs(x - target_speed_float))
    return shutter_speeds[shutter_speeds_float.index(closest_speed)]

def aquire_shutterspeed_test_images(camera, numAroundDefault=4, skipSelections=0, defaultShutterSpeed=None):
    config = camera.get_config()
    # Find the Shutter Speed property
    if defaultShutterSpeed is None:
        camera, config = set_auto_exposure_mode(camera, "A")
        defaultShutterSpeed = config.get_child_by_label("Shutter Speed").get_value()
    shutter_speeds = [choice for choice in config.get_child_by_label("Shutter Speed").get_choices()]
    # Find the closest shutter speed if the provided one is not in the list
    if defaultShutterSpeed not in shutter_speeds:
        defaultShutterSpeed = find_closest_shutter_speed(shutter_speeds, defaultShutterSpeed)
    # Find the index of the defaultShutterSpeed in the shutter_speeds array
    index = shutter_speeds.index(defaultShutterSpeed)
    # Create a new array with the speeds below and above the defaultShutterSpeed, skipping selections as specified
    step = skipSelections + 1
    new_speeds = shutter_speeds[max(0, index-numAroundDefault*step):index+numAroundDefault*step+1:step]
    # Need to add third variable for if USB is selected for the path on computer
    setCaptureTargetOnCamera(camera, "USB")
    images = []
    labels = []
    for speed in new_speeds:
        # Set the shutter speed
        camera, config = set_shutter_speed(camera, speed)
        # Capture a preview image
        camera_file = camera.capture_preview()
        # Read the image data
        file_data = gp.check_result(gp.gp_file_get_data_and_size(camera_file))
        # Convert the image data to a PIL Image
        image = Image.open(io.BytesIO(file_data))
        # Convert the PIL Image to a format suitable for OpenCV
        images.append(cv2.cvtColor(np.array(image), cv2.COLOR_RGB2BGR))
        labels.append(str(speed))
    
    # Determine the grid size
    grid_size = int(np.ceil(np.sqrt(len(images))))
    img_height, img_width, _ = images[0].shape
    grid_img_height = img_height * grid_size
    grid_img_width = img_width * grid_size
    
    # Create a blank composite image
    composite_image = np.zeros((grid_img_height, grid_img_width, 3), dtype=np.uint8)
    
    # Place images into the composite image
    for i, img in enumerate(images):
        row = i // grid_size
        col = i % grid_size
        y = row * img_height
        x = col * img_width
        composite_image[y:y+img_height, x:x+img_width] = img
        # Add label to the image
        cv2.putText(composite_image, labels[i], (x + 10, y + 30), cv2.FONT_HERSHEY_SIMPLEX, 1, (255, 255, 255), 2)
    
    # Display the composite image in a resizable window
    cv2.namedWindow("Shutter Speed Test Images", cv2.WINDOW_NORMAL)
    cv2.imshow("Shutter Speed Test Images", composite_image)
    cv2.waitKey(0)
    cv2.destroyAllWindows()
    
    camera, config = set_auto_exposure_mode(camera, "M")

def set_auto_exposure_mode(camera, value=True):
    config = camera.get_config()

    # Find the Auto Focus Mode property
    property = config.get_child_by_label("Exposure Program")
    # Set the auto focus mode value
    property.set_value(value)
    #for choice in property.get_choices():
    #    print(choice)

    # Save the configuration
    camera.set_config(config)
    return camera, config

