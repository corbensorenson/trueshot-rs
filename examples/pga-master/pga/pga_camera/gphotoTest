def set_white_balance(camera, value):
    try:
        # Get the main configuration
        config = camera.get_config()

        # Find the WhiteBalance property
        property = config.get_child_by_label("WhiteBalance")
        

        # Check if the property is writable
        if property.get_readonly():
            print("White balance is read-only and cannot be set.")
            return

        # Set the white balance value
        property.set_value(value)

        # Save the configuration
        camera.set_config(config)
        print("White balance set successfully!")
    except gp.GPhoto2Error as e:
        print(f"Error setting white balance: {e}")
    return camera, config

def get_settings(camera, config=None):
    try:
        # Get the main configuration
        #only needs to be called once and it updates a internal widget list
        config = camera.get_config() if config is None else config
        

        # Print the main configuration settings
        for child in config.get_children():
            label = child.get_label()
            print(f"Label: {label}")
            for sub_child in child.get_children():
                sub_label = sub_child.get_label()
                sub_value = sub_child.get_value()
                print(f">{sub_label}: {sub_value}")
                if sub_child.get_children():
                    for sub_sub_child in sub_child.get_children():
                        sub_sub_label = sub_sub_child.get_label()
                        sub_sub_value = sub_sub_child.get_value()
                        print(f">>{sub_sub_label}: {sub_sub_value}")

    except gp.GPhoto2Error as e:
        print(f"Error getting main configuration settings: {e}")

def take_picture():
    try:
        # Initialize the camera
        camera = gp.Camera()
        try:
            camera.init()
            print("Camera initialized successfully.")
        except gp.GPhoto2Error as e:
            print(f"Error initializing camera: {e}")
            exit(1)

        # Capture an image
        file_path = camera.capture(gp.GP_CAPTURE_IMAGE)

        # Download the captured image
        camera_file = camera.file_get(file_path.folder, file_path.name, gp.GP_FILE_TYPE_NORMAL)
        camera_file.save('/path/to/save/image.jpg')

        # Clean up the camera
        camera.exit()

        print("Picture taken successfully!")
    except gp.GPhoto2Error as e:
        print(f"Error taking picture: {e}")

